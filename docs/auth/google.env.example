# Server only. No secrets are supplied by this example; disabled by default.
ALAGEUM_GOOGLE_ENABLED=false
ALAGEUM_BROWSER_ORIGIN=http://localhost:3000
ALAGEUM_GOOGLE_CLIENT_ID=
ALAGEUM_GOOGLE_CLIENT_SECRET=
# Frontend and /api/v1 must share the approved origin. See federated-registration.md.
NEXT_PUBLIC_API_URL=/api/v1
# eGov has no enable flag until its actual service contract/protocol is verified.
