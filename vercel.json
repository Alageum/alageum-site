{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "installCommand": "npm ci",
      "buildCommand": "ALAGEUM_PUBLIC_ONLY=1 npm run build",
      "devCommand": "ALAGEUM_PUBLIC_ONLY=1 npm run dev"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
