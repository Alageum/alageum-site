# Copy to /etc/alageum/stack.env. This file contains configuration, not secrets.
# Values below are examples and require operator review. Compose v2.30+ required.
ALAGEUM_PROJECT_NAME=alageum
ALAGEUM_RELEASE=
ALAGEUM_HOSTNAME=
ALAGEUM_DATA_DIR=/srv/alageum/data
ALAGEUM_TLS_DIR=/etc/alageum/tls
ALAGEUM_SECRET_DIR=/etc/alageum/secrets
ALAGEUM_BACKEND_ENV_FILE=/etc/alageum/backend.env
