# Copy OUTSIDE the checkout to /etc/alageum/backend.env, mode 0600.
# Raw env_file syntax: values are literal; no shell quotes or ${interpolation}.
# Required independent runtime secrets. APP_KEYS needs 2-8 independent values.
APP_KEYS=
ADMIN_JWT_SECRET=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
ALAGEUM_JWT_SECRET=
# Use the exact app-role password also stored in secrets/postgres-app-password.
# Percent-encode reserved URL characters. No URL query parameters.
DATABASE_URL=
# Shape: postgresql://alageum_app:<encoded-password>@postgres:5432/alageum_strapi
# Approved SMTP provider only. STARTTLS is required on 587/2525; 465 uses TLS.
ALAGEUM_REGISTRATION_MAIL_PROVIDER=smtp
ALAGEUM_SMTP_HOST=
ALAGEUM_SMTP_PORT=587
ALAGEUM_SMTP_TLS_SERVERNAME=
ALAGEUM_MAIL_FROM=
ALAGEUM_SMTP_USER=
ALAGEUM_SMTP_PASSWORD=
# Environment invariants (HTTPS origin, TLS, disabled demo/import/EDS/Google,
# trusted edge and persistent paths) are explicitly enforced by Compose.

# Existing app-owned 0700 directory, outside public uploads/quarantine.
# ALAGEUM_DOCUMENT_ROOT=/absolute/private-documents

# Explicit supplier routing for client-generated immutable quote PDFs; leave blank until confirmed.
ALAGEUM_QUOTE_SIGNING_ORGANIZATION_ID=
ALAGEUM_QUOTE_SIGNING_MANAGER_ID=
