# Generate independent development secrets. Never reuse the legacy database.
APP_ENV=development
NODE_ENV=development
HOST=127.0.0.1
PORT=8000
DATABASE_URL=
DATABASE_SSL=false
APP_KEYS=
ADMIN_JWT_SECRET=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
ALAGEUM_JWT_SECRET=
ALAGEUM_SEED_DEMO=0
ALAGEUM_IMPORT_CATALOG=1
ALAGEUM_EDS_ENABLED=0
ALAGEUM_GOOGLE_ENABLED=0
ALAGEUM_GOOGLE_CLIENT_ID=
ALAGEUM_GOOGLE_CLIENT_SECRET=
ALAGEUM_BROWSER_ORIGIN=
# Registration is deliberately unavailable until an approved SMTP provider is configured.
ALAGEUM_REGISTRATION_MAIL_PROVIDER=disabled
ALAGEUM_SMTP_HOST=
ALAGEUM_SMTP_PORT=587
# Optional DNS certificate name when SMTP_HOST is an IP. Certificate verification stays on.
ALAGEUM_SMTP_TLS_SERVERNAME=
ALAGEUM_MAIL_FROM=
ALAGEUM_SMTP_USER=
ALAGEUM_SMTP_PASSWORD=
# Local operator CLI only; never put a real database URL in this tracked template.
ALAGEUM_OPERATOR_DATABASE_URL=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
POSTGRES_PASSWORD=
POSTGRES_DB=alageum_strapi_handoff
POSTGRES_USER=alageum_strapi
STRAPI_TELEMETRY_DISABLED=true
STRAPI_HIDE_UPDATE_MESSAGE=true
# Trust forwarded client addresses only from these exact proxy IPs (comma-separated).
# Empty is safest unless a reviewed reverse proxy is actually configured.
ALAGEUM_TRUSTED_PROXY_IPS=
# New media uploads fail closed until one approved malware-scanner endpoint is set.
# Choose socket OR literal loopback/private IP host, never both. Both blank => HTTP 503.
ALAGEUM_MEDIA_CLAMAV_SOCKET=
ALAGEUM_MEDIA_CLAMAV_HOST=
ALAGEUM_MEDIA_CLAMAV_PORT=3310
ALAGEUM_MEDIA_SCAN_TIMEOUT_MS=10000
# Optional absolute app-owned private path, outside the public/static root.
# ALAGEUM_MEDIA_QUARANTINE_DIR=/absolute/private/quarantine/path
# Explicit persistent media root for deployment; pre-create root/uploads and a
# separate private quarantine. Local directory checks do not prove mount durability.
ALAGEUM_MEDIA_PUBLIC_ROOT=

# Existing app-owned 0700 directory, outside public uploads/quarantine.
# ALAGEUM_DOCUMENT_ROOT=/absolute/private-documents
