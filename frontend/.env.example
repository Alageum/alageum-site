# Local public site works without API; keep static until backend integration is deliberate.
NEXT_PUBLIC_CATALOG_SOURCE=static
NEXT_PUBLIC_API_URL=
API_INTERNAL_BASE_URL=
COMPANY_SOURCE=static
PAGES_SOURCE=api
PAGES_SITE_ORIGIN=
PAGES_STATIC_PREVIEW=0

# Server-only fallback for message forms when Bitrix24 is not configured.
# Use a Resend sending key and a sender on a verified domain.
RESEND_API_KEY=
ALAGEUM_CONTACT_FROM=

# Server-only Bitrix24 webhook. Requires CRM contact, lead and timeline
# read/create permissions, including duplicate search. Source: ADVERTISING.
BITRIX24_WEBHOOK_URL=
