# Actual Node/Strapi and frontend runtime. Secret values deliberately empty.
APP_ENV=development
NODE_ENV=development
HOST=127.0.0.1
PORT=8000
DATABASE_URL=
DATABASE_SSL=false
APP_KEYS=
ADMIN_JWT_SECRET=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
ALAGEUM_JWT_SECRET=
ALAGEUM_SEED_DEMO=0
ALAGEUM_IMPORT_CATALOG=1
ALAGEUM_EDS_ENABLED=0
ALAGEUM_GOOGLE_ENABLED=0
ALAGEUM_GOOGLE_CLIENT_ID=
ALAGEUM_GOOGLE_CLIENT_SECRET=
ALAGEUM_BROWSER_ORIGIN=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NODE_POSTGRES_PASSWORD=
POSTGRES_PASSWORD=
POSTGRES_DB=alageum_strapi_handoff
POSTGRES_USER=alageum_strapi
NODE_API_PORT=8000
NODE_FRONTEND_PORT=3000
NODE_ENV_FILE=
STRAPI_TELEMETRY_DISABLED=true
STRAPI_HIDE_UPDATE_MESSAGE=true
NEXT_PUBLIC_CATALOG_SOURCE=static
NEXT_PUBLIC_API_URL=
API_INTERNAL_BASE_URL=
COMPANY_SOURCE=static
PAGES_SOURCE=api
PAGES_SITE_ORIGIN=
PAGES_STATIC_PREVIEW=0

# Legacy Python configuration; do not activate for the Node stack.
APP_DEBUG=false
APP_SECRET_KEY=
APP_DATABASE_URL=
APP_CORS_ORIGINS=["http://localhost:3000"]
APP_ACCESS_TOKEN_MINUTES=15
APP_REFRESH_TOKEN_DAYS=30
APP_BROWSER_TOKEN_TRANSPORT=session_storage
APP_AI_CONFIRMATION_MINUTES=10
APP_STORAGE_BACKEND=local
APP_FILE_SCANNER_BACKEND=noop
APP_LOCAL_STORAGE_PATH=/app/storage
APP_MAX_UPLOAD_BYTES=10485760
APP_MAX_REQUEST_BYTES=12582912
APP_AI_MAX_INPUT_LENGTH=10000
APP_INTEGRATION_JOB_LEASE_SECONDS=300
APP_RATE_LIMIT_REQUESTS={"login":30,"password_reset":5,"ai_chat":30,"file_upload":20,"public_form":10,"quote_create":10}
APP_DEFAULT_LOCALE=ru
APP_AVAILABLE_LOCALES=["ru","kk","en","zh","uz"]
APP_FALLBACK_LOCALE=ru
APP_CATALOG_ALLOWED_CURRENCIES=[]

